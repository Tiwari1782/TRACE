# ─────────────────────────────────────────────────────────────────────────────
# TRACE — Environment Variable Template
# Copy this file to server/.env and client/.env and fill in real values.
# NEVER commit .env files. See .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/trace?sslmode=require

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development

# ── Deployment ───────────────────────────────────────────────────────────────
VERCEL_DOMAIN=https://trace-client.vercel.app

# ── External Data APIs ────────────────────────────────────────────────────────
NOAA_STORM_URL=https://www.nhc.noaa.gov/CurrentStorms.json
JTWC_BULLETIN_URL=https://www.metoc.navy.mil/jtwc/jtwc.html
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast

# ── Storm Refresh Intervals ───────────────────────────────────────────────────
STORM_REFRESH_MINUTES=10
WIND_FIELD_REFRESH_MINUTES=10

# ── Satellite / ASCAT (EUMETSAT) ──────────────────────────────────────────────
EUMETSAT_ASCAT_KEY=your-eumetsat-key

# ── ML Model Download (Render startup) ───────────────────────────────────────
# URL to a GitHub Release containing trace_lstm.keras and trace_rf.pkl
MODEL_RELEASE_URL=https://github.com/Tiwari1782/TRACE/releases/download/v1.0/models.zip

# ─────────────────────────────────────────────────────────────────────────────
# CLIENT-SIDE VARIABLES (prefix VITE_ for Vite to expose them)
# These go in client/.env
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_MAPBOX_TOKEN=pk.eyxxxxxxxxxxxx
