# TRACE — .gitignore

# ── ML data & trained models (large files, never commit) ──────────────────────
ml/data/
ml/saved_models/
*.nc
*.npy
*.keras
*.pkl

# ── Environment files ─────────────────────────────────────────────────────────
server/.env
client/.env
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
.venv/
env/
.Python
pip-log.txt

# ── Node / React ──────────────────────────────────────────────────────────────
node_modules/
client/dist/
client/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ── Editor / OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Coverage ──────────────────────────────────────────────────────────────────
htmlcov/
.coverage
.pytest_cache/


